# Título automático (opcional). Sem credencial, use --title.
ANTHROPIC_API_KEY=
VICECLIPS_TITLE_LANG=pt-BR
VICECLIPS_TITLE_MODEL=claude-opus-5-5

# Minutos até um clip pronto ser apagado (0 = nunca apagar).
VICECLIPS_CLIP_TTL_MINUTES=10
# Legendas: 0 desliga; modelo tiny/base/small/medium (maior = melhor e mais lento).
VICECLIPS_CAPTIONS=1
VICECLIPS_WHISPER_MODEL=small
# Idioma do streamer: só fala nesse idioma vira legenda (o jogo, em inglês, fica de fora).
VICECLIPS_CAPTION_LANG=pt
# Quantas lives podem ser acompanhadas ao mesmo tempo.
VICECLIPS_MAX_LIVES=4

# Senha do site; obrigatória para `viceclips web --host 0.0.0.0`.
VICECLIPS_PASSWORD=
